<?xml version="1.0"?>
<package format="2">
  <name>lidar_people_cluster_viewer</name>
  <version>0.0.1</version>
  <description>OpenCV top-view viewer for fused lidar cloud and people markers</description>

  <maintainer email="you@example.com">you</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <!-- English comment:
       OpenCV is provided by system package on Ubuntu.
       This rosdep key generally resolves on Ubuntu. -->
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>

</package>
